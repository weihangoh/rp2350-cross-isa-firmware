if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "Usage: cmake -DINPUT=<bin> -DOUTPUT=<h> -DSYMBOL=<name> -P bin2h.cmake")
endif()

file(READ "${INPUT}" HEXDATA HEX)
string(LENGTH "${HEXDATA}" HEX_LEN)
math(EXPR BYTE_COUNT "${HEX_LEN} / 2")

file(WRITE "${OUTPUT}" "#pragma once\n")
file(APPEND "${OUTPUT}" "#include <stdint.h>\n")
file(APPEND "${OUTPUT}" "#define ${SYMBOL}_LEN ${BYTE_COUNT}u\n")
file(APPEND "${OUTPUT}" "static const uint8_t ${SYMBOL}[${SYMBOL}_LEN] = {\n    ")

set(i 0)
while(i LESS BYTE_COUNT)
    math(EXPR off "${i} * 2")
    string(SUBSTRING "${HEXDATA}" ${off} 2 byte)
    file(APPEND "${OUTPUT}" "0x${byte}")
    math(EXPR next "${i} + 1")
    if(next LESS BYTE_COUNT)
        file(APPEND "${OUTPUT}" ", ")
    endif()
    math(EXPR mod "${next} % 12")
    if(mod EQUAL 0 AND next LESS BYTE_COUNT)
        file(APPEND "${OUTPUT}" "\n    ")
    endif()
    set(i ${next})
endwhile()

file(APPEND "${OUTPUT}" "\n};\n")
